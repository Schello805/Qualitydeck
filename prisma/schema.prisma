generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Department {
  id          String   @id @default(uuid())
  name        String
  manager     String?
  processType String?  // 'management', 'core', 'support'
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  audits      Audit[]

  @@index([order, name])
}

model Requirement {
  id           String      @id @default(uuid())
  chapter      String      @unique
  title        String
  description  String
  category     String?
  originalText String?
  departments  String?     @default("all") // stored as JSON or comma separated string
  roles        String?     @default("all")
  isStandard   Boolean     @default(true)
  auditItems   AuditItem[]

  @@index([category])
}

model Audit {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  auditor      String
  date         DateTime    @default(now())
  status       String      @default("open") // open, in_progress, completed
  items        AuditItem[]

  @@index([departmentId])
  @@index([status])
}

model AuditItem {
  id                   String      @id @default(uuid())
  auditId              String
  audit                Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requirementId        String
  requirement          Requirement @relation(fields: [requirementId], references: [id])
  status               String      @default("open") // fulfilled, partially, not_fulfilled, not_applicable
  implementationNotes  String? // Korrekturmaßnahme
  immediateAction      String? // Sofortmaßnahme
  preventiveAction     String? // Langfristige Abstellmaßnahme zur Vermeidung von Wiederholungen
  evidenceFileUrl      String?
  evidenceLink         String?
  plannedDate             String? // Zieldatum 2. Korrekturmaßnahme (max. 10 Tage)
  immediatePlannedDate    String? // Zieldatum 1. Sofortmaßnahme (max. 3 Tage)
  preventivePlannedDate   String? // Zieldatum 3. Langfristige Abstellmaßnahme (max. 30 Tage)
  extensionHistory        String? // JSON-Array mit dokumentierten Fristverlängerungen
  responsible             String?
  responsibleEmail        String?
  emailSent               Boolean     @default(false)
  auditee                 String?
  auditDate               String?

  @@index([auditId])
  @@index([requirementId])
  @@index([status])
  @@index([plannedDate])
}

model Complaint {
  id                    String            @id @default(uuid())
  title                 String
  description           String
  type                  String            // 'internal' | 'supplier' | 'customer'
  status                String            @default("open") // open, in_progress, closed
  pdcaPhase             String?           @default("plan") // 'plan' | 'do' | 'check' | 'act'

  // 1. Sofortmaßnahme (Containment) - SLA: max 3 Tage
  immediateAction       String?
  immediatePlannedDate  String?

  // Ursachenanalyse (Root Cause / 5-Why / Ishikawa)
  rootCause             String?

  // 2. Korrekturmaßnahme (Korrektur & Ursachenbeseitigung) - SLA: max 10 Tage
  correctiveAction      String?
  plannedDate           String?

  // 3. Langfristige Abstellmaßnahme (Wiederholvermeidung) - SLA: max 30 Tage
  preventiveAction      String?
  preventivePlannedDate String?

  // Check (D8 Wirksamkeitsprüfung)
  effectivenessCheck    String?
  effectivenessDate     String?
  effectivenessVerifier String?

  // Act (Standardisierung & Lessons Learned)
  standardizationNote   String?
  standardizedDocs      String?

  // Verantwortlicher Gesamt-Reklamation
  responsible           String?
  responsibleEmail      String?
  extensionHistory      String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  actions               ComplaintAction[]

  @@index([status])
  @@index([createdAt])
}

model ComplaintAction {
  id               String    @id @default(uuid())
  complaintId      String
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  description      String
  actionType       String?   @default("corrective") // 'immediate' | 'corrective' | 'preventive'
  pdcaPhase        String?   @default("do") // 'plan' | 'do' | 'check' | 'act'
  responsible      String
  responsibleEmail String?
  plannedDate      DateTime
  status           String    @default("open") // open, in_progress, done
  extensionHistory String?
  emailSent        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([complaintId])
  @@index([status])
  @@index([plannedDate])
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String?   // Hashed password (salt:hash)
  role       String?   @default("Mitarbeiter") // 'QMB', 'Auditor', 'Abteilungsleiter', 'Mitarbeiter'
  department String?
  image      String?   // Profile picture / Avatar (Data URL or URL)
  phone      String?
  isActive   Boolean   @default(true)
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

